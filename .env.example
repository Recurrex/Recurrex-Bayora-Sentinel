# Copy this file to .env (never commit .env) and fill in the key.
#
# Google AI Studio key: https://aistudio.google.com/apikey
# When GEMINI_API_KEY is set, the AI sandbox and the broker talk to Gemini.
# Without it every piece of the range still works, using the offline stub model
# and the deterministic judge.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: point the real broker at a local Ollama container instead.
# AI_URL=http://ai:11434
# AI_MODEL=sentinel-model
